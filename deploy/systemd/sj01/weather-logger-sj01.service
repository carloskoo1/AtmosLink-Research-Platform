[Unit]
Description=AtmosLink Weather Logger SJ01
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=ckoo
Group=ckoo
WorkingDirectory=/home/ckoo/Proyectos/EstacionMeteorologica

Environment=ATMOSLINK_STATION=SJ01
Environment=ATMOSLINK_WIND_ENABLED=1
Environment=ATMOSLINK_WIND_PORT=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
Environment=ATMOSLINK_WIND_BAUDRATE=9600
Environment=ATMOSLINK_WIND_SLAVE_ID=1
Environment=ATMOSLINK_WIND_TIMEOUT=2.0

ExecStart=/home/ckoo/Proyectos/EstacionMeteorologica/venv/bin/python -u -m weather_station.logger.logger_weather

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
